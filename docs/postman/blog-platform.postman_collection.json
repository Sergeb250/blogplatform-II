        },
        {
          "name": "Bad direction (400)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/posts?direction=SIDEWAYS" }
        },
        {
          "name": "Page size 0 (400)",
          "event": [{ "listen": "test", "script": { "exec": [
