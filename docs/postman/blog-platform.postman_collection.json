          "request": { "method": "GET", "url": "{{baseUrl}}/api/posts?size=0" }
        }
      ]
    },
    {
      "name": "06. Comments",
      "item": [
        {
          "name": "Add comment to post",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('commentId', pm.response.json().data.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": {{userId}},\n  \"content\": \"Great post, written from Postman!\"\n}" },
            "url": "{{baseUrl}}/api/posts/{{postId}}/comments"
          }
        },
        {
