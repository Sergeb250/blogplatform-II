          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/posts?authorId={{userId}}&status=PUBLISHED&sortBy=title&direction=ASC&page=0&size=10" }
        },
        {
          "name": "Keyword search",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
