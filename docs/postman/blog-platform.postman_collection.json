{
  "info": {
    "name": "Blogging Platform API",
    "description": "Every REST and GraphQL endpoint of the Blogging Platform, with ready-to-send payloads and status-code tests.\n\nHOW TO USE\n1. Start the app (http://localhost:8080).\n2. Run the whole collection with the Collection Runner, in order. 'Create user' makes a unique run number ({{run}}) so the collection can run many times without duplicate errors.\n3. Every 'Create' request saves the new id in a collection variable (userId, tagId, postId, commentId, reviewId, gqlPostId) that later requests use.\n4. The last folder deletes everything that was created, so the database ends as it started.\n\nRequests named '(400)', '(401)', '(404)' or '(409)' are negative tests: they SHOULD fail with that status.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "run", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "tagId", "value": "" },
    { "key": "postId", "value": "" },
    { "key": "commentId", "value": "" },
    { "key": "reviewId", "value": "" },
    { "key": "gqlPostId", "value": "" }
  ],
  "event": [
    {
      "listen": "test",
      "script": { "exec": [
        "pm.test('response time under 2 s', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
      ] }
    }
  ],
  "item": [
    {
      "name": "00. System & Docs",
      "item": [
        {
          "name": "System info",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('has status, message, data', () => pm.expect(pm.response.json()).to.have.keys('status', 'message', 'data'));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/system/info" }
        },
        {
          "name": "OpenAPI JSON (Swagger)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('is OpenAPI 3', () => pm.expect(pm.response.json().openapi).to.match(/^3/));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/v3/api-docs" }
        }
      ]
    },
    {
      "name": "01. Users",
      "item": [
        {
          "name": "Create user",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "// unique number for this run, so usernames, emails and tag names never clash",
              "pm.collectionVariables.set('run', Date.now().toString().slice(-7));"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Location header', () => pm.response.to.have.header('Location'));",
              "const body = pm.response.json();",
              "pm.test('no password in response', () => { pm.expect(body.data).to.not.have.property('password'); pm.expect(body.data).to.not.have.property('passwordHash'); });",
              "pm.collectionVariables.set('userId', body.data.id);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"pm_{{run}}\",\n  \"email\": \"pm_{{run}}@test.local\",\n  \"password\": \"secret123\",\n  \"role\": \"AUTHOR\"\n}" },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Get all users",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('data is a list', () => pm.expect(pm.response.json().data).to.be.an('array'));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users" }
        },
        {
          "name": "Get user by id",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('right user', () => pm.expect(pm.response.json().data.username).to.eql('pm_' + pm.collectionVariables.get('run')));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/{{userId}}" }
        },
        {
          "name": "Update user",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('email changed', () => pm.expect(pm.response.json().data.email).to.eql('pm_' + pm.collectionVariables.get('run') + '.new@test.local'));"
          ] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"pm_{{run}}\",\n  \"email\": \"pm_{{run}}.new@test.local\",\n  \"role\": \"AUTHOR\"\n}" },
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Create user - invalid email (400)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
            "pm.test('error for email field', () => pm.expect(pm.response.json().data).to.have.property('email'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"bad_mail_user\",\n  \"email\": \"not-an-email\",\n  \"password\": \"secret123\"\n}" },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Create user - short password and blank username (400)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
            "pm.test('errors for both fields', () => pm.expect(pm.response.json().data).to.include.keys('username', 'password'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"\",\n  \"email\": \"someone@test.local\",\n  \"password\": \"123\"\n}" },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Create user - duplicate username (409)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"pm_{{run}}\",\n  \"email\": \"other_{{run}}@test.local\",\n  \"password\": \"secret123\"\n}" },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Create user - duplicate email (409)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"other_{{run}}\",\n  \"email\": \"pm_{{run}}.new@test.local\",\n  \"password\": \"secret123\"\n}" },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Get missing user (404)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/999999" }
        }
      ]
    },
    {
      "name": "02. Auth",
      "item": [
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('returns the user', () => pm.expect(pm.response.json().data.id).to.eql(Number(pm.collectionVariables.get('userId'))));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"pm_{{run}}\",\n  \"password\": \"secret123\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login - wrong password (401)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"pm_{{run}}\",\n  \"password\": \"wrong-password\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login - empty fields (400)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"\",\n  \"password\": \"\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "03. Tags",
      "item": [
        {
          "name": "Create tag",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('tagId', pm.response.json().data.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman{{run}}\"\n}" },
            "url": "{{baseUrl}}/api/tags"
          }
        },
        {
          "name": "Get all tags",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/tags" }
        },
        {
          "name": "Get tag by id",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/tags/{{tagId}}" }
        },
        {
          "name": "Update tag",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('renamed', () => pm.expect(pm.response.json().data.name).to.eql('Postman' + pm.collectionVariables.get('run') + 'Updated'));"
          ] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman{{run}}Updated\"\n}" },
            "url": "{{baseUrl}}/api/tags/{{tagId}}"
          }
        },
        {
          "name": "Create tag - duplicate name (409)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman{{run}}Updated\"\n}" },
            "url": "{{baseUrl}}/api/tags"
          }
        },
        {
          "name": "Create tag - empty name (400)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"\"\n}" },
            "url": "{{baseUrl}}/api/tags"
          }
        }
      ]
    },
    {
      "name": "04. Posts - CRUD",
      "item": [
        {
          "name": "Create post",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.test('Location header', () => pm.response.to.have.header('Location'));",
            "const post = pm.response.json().data;",
            "pm.test('has the tag', () => pm.expect(post.tags.map(t => t.id)).to.include(Number(pm.collectionVariables.get('tagId'))));",
            "pm.collectionVariables.set('postId', post.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Postman test post {{run}}\",\n  \"content\": \"This post was created from the Postman collection to test the API.\",\n  \"authorId\": {{userId}},\n  \"status\": \"PUBLISHED\",\n  \"tagIds\": [{{tagId}}]\n}" },
            "url": "{{baseUrl}}/api/posts"
          }
        },
        {
          "name": "Get post by id",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/posts/{{postId}}" }
        },
        {
          "name": "Update post",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('title changed', () => pm.expect(pm.response.json().data.title).to.include('updated'));"
          ] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Postman test post {{run}} updated\",\n  \"content\": \"The content was changed by the Update post request.\",\n  \"status\": \"PUBLISHED\",\n  \"tagIds\": [{{tagId}}]\n}" },
            "url": "{{baseUrl}}/api/posts/{{postId}}"
          }
        },
        {
          "name": "Create post - empty title (400)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
            "pm.test('title error', () => pm.expect(pm.response.json().data).to.have.property('title'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"\",\n  \"content\": \"Content that is long enough for validation.\",\n  \"authorId\": {{userId}}\n}" },
            "url": "{{baseUrl}}/api/posts"
          }
        },
        {
          "name": "Create post - content too short (400)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
            "pm.test('content error', () => pm.expect(pm.response.json().data).to.have.property('content'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Too short\",\n  \"content\": \"short\",\n  \"authorId\": {{userId}}\n}" },
            "url": "{{baseUrl}}/api/posts"
          }
        },
        {
          "name": "Create post - unknown author (404)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Ghost author\",\n  \"content\": \"Content that is long enough for validation.\",\n  \"authorId\": 999999\n}" },
            "url": "{{baseUrl}}/api/posts"
          }
        },
        {
          "name": "Get missing post (404)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/posts/999999" }
        },
        {
          "name": "Create post - title already used (409)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
            "pm.test('title error', () => pm.expect(pm.response.json().data).to.have.property('title'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"POSTMAN TEST POST {{run}} UPDATED\",\n  \"content\": \"Same title as the post above (upper/lower case does not matter).\",\n  \"authorId\": {{userId}}\n}" },
            "url": "{{baseUrl}}/api/posts"
          }
        }
      ]
    },
    {
      "name": "05. Posts - Paging, Sorting, Filtering, Search",
      "item": [
        {
          "name": "Page 0, size 5",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const page = pm.response.json().data;",
            "pm.test('at most 5 posts', () => pm.expect(page.content.length).to.be.at.most(5));",
            "pm.test('has paging info', () => pm.expect(page).to.include.keys('page', 'size', 'totalElements', 'totalPages'));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/posts?page=0&size=5" }
        },
        {
          "name": "Sort newest first (created_at DESC)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const dates = pm.response.json().data.content.map(p => p.createdAt);",
            "pm.test('newest first', () => pm.expect(dates).to.eql([...dates].sort().reverse()));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/posts?sortBy=created_at&direction=DESC" }
        },
        {
          "name": "Sort by title A-Z",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/posts?sortBy=title&direction=ASC" }
        },
        {
          "name": "Sort by rating (best first)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/posts?sortBy=rating&direction=DESC" }
        },
        {
          "name": "Filter by author",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const id = Number(pm.collectionVariables.get('userId'));",
            "pm.test('only this author', () => pm.response.json().data.content.forEach(p => pm.expect(p.authorId).to.eql(id)));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/posts?authorId={{userId}}" }
        },
        {
          "name": "Filter by tag name",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('finds the new post', () => pm.expect(pm.response.json().data.content.map(p => p.id)).to.include(Number(pm.collectionVariables.get('postId'))));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/posts?tag=Postman{{run}}Updated" }
        },
        {
          "name": "Filter by status (DRAFT)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
