<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot's parent chooses matching versions for every Spring library, Jackson, JUnit, ... -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>com.amali</groupId>
    <artifactId>blogPlatform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Blogging Platform</name>
    <description>REST and GraphQL API over the bloggingPlatform MySQL database, using Spring JDBC (no JPA)</description>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>2.8.13</springdoc.version>
        <jbcrypt.version>0.4</jbcrypt.version>
        <!-- Tests tagged @Tag("benchmark") need MySQL and are skipped by "./mvnw test".
             Run the benchmark with the "benchmark" profile below:  ./mvnw test -Pbenchmark -->
        <excludedTestGroups>benchmark</excludedTestGroups>
    </properties>

    <profiles>
        <!-- ./mvnw test -Pbenchmark  runs ONLY QueryBenchmarkTest and prints its report.
             Bigger data set:  ./mvnw test -Pbenchmark -DbenchmarkPosts=100000
             (no dots in these names, so the command works the same in PowerShell, cmd and bash) -->
        <profile>
            <id>benchmark</id>
            <properties>
                <excludedTestGroups>none</excludedTestGroups>
                <test>QueryBenchmarkTest</test>
            </properties>
        </profile>
    </profiles>

    <dependencies>
        <!-- REST API (Spring MVC + embedded Tomcat + Jackson) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Database access with JdbcTemplate + HikariCP connection pool (no JPA / Hibernate) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- Bean Validation (Hibernate Validator is only the validation engine, not the ORM) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Logging and performance monitoring aspects -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!-- GraphQL API alongside REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-graphql</artifactId>
        </dependency>
        <!-- OpenAPI documentation + Swagger UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <!-- MySQL JDBC driver for the existing bloggingPlatform database -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- BCrypt password hashing -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>${jbcrypt.version}</version>
        </dependency>

        <!-- Tests: JUnit 5, Mockito, AssertJ, MockMvc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.graphql</groupId>
            <artifactId>spring-graphql-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- In-memory database for the "test" profile -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${excludedTestGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
